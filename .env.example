# ==========================================================================
# ChatBI Copilot - environment variables
# Copy to `.env` (used by docker-compose) and fill in your LLM API key.
# NEVER commit your real .env.
# ==========================================================================

# ---- LLM (any OpenAI-compatible endpoint) ----
# Mock 零密钥演示（Docker / 作品集默认，无需 LLM_API_KEY）：
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=mock
LLM_API_KEY=
LLM_API_STYLE=chat-completions

# DeepSeek（接入真实模型时取消注释并填写 Key）：
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-key-here

# OpenAI:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-sol
# LLM_API_KEY=sk-...
# LLM_API_STYLE=responses

# Qwen (DashScope OpenAI-compatible mode):
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-...

# Ollama (local, no key needed):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# Optional tuning
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=60

# ---- Security ----
# Secret used to encrypt stored datasource passwords. CHANGE in production.
CHATBI_SECRET=chatbi-copilot-dev-secret-change-me
CHATBI_PRODUCTION_MODE=false
CHATBI_COOKIE_SECURE=false
CHATBI_ALLOWED_ORIGINS=http://localhost:19031,http://127.0.0.1:19031

# ---- Local demo login (only when DEMO_AUTH_ENABLED=true) ----
DEMO_AUTH_ENABLED=true
DEMO_ADMIN_PASSWORD=ChatBI!Admin123
DEMO_ANALYST_PASSWORD=ChatBI!Analyst123
DEMO_VIEWER_PASSWORD=ChatBI!Viewer123

# ---- Demo datasource (auto-registered on first startup when enabled) ----
DEMO_DATASOURCE_ENABLED=true
DEMO_DB_HOST=mysql
DEMO_DB_PORT=3306
DEMO_DB_NAME=chatbi_demo
DEMO_DB_USER=chatbi_ro
DEMO_DB_PASSWORD=ChatBI!Readonly123
DEMO_PG_ENABLED=true
DEMO_PG_HOST=postgres
DEMO_PG_PORT=5432
DEMO_PG_DB_NAME=chatbi_demo
DEMO_PG_USER=chatbi_ro
DEMO_PG_PASSWORD=ChatBI!Readonly123

# ---- Demo MySQL container root/user (used by docker-compose) ----
MYSQL_ROOT_PASSWORD=LocalDemoRoot!2026
POSTGRES_ADMIN_PASSWORD=LocalDemoPgAdmin!2026
DEMO_READONLY_PASSWORD=ChatBI!Readonly123

# Host ports are intentionally confined to the 19030-19039 acceptance range.
MYSQL_HOST_PORT=19032
POSTGRES_HOST_PORT=19033
BACKEND_HOST_PORT=19030
FRONTEND_HOST_PORT=19031
