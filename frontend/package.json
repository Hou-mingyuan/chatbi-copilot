{
  "name": "chatbi-copilot-frontend",
  "version": "1.0.0",
  "description": "ChatBI Copilot frontend - natural language to SQL data analysis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=1 vite build",
