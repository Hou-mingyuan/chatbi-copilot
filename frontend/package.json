  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.3",
