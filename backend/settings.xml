<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings for fast, reproducible builds in mainland China.
  Routes ALL repositories through the Aliyun public mirror (which aggregates Maven Central,
  Spring, etc.), so no corporate/internal Nexus is required.

  Usage:  mvn -s settings.xml <goal>
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>aliyun-public</id>
            <name>Aliyun Public Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
